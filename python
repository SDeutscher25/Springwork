import turtle

# --- SETUP ---
screen = turtle.Screen()
screen.setup(width=400, height=400)
# 1. THE SKY (Furthest back layer)
screen.bgcolor("skyblue") 
screen.tracer(0) # Turns off the drawing animation so it appears instantly

pen = turtle.Turtle()
pen.hideturtle()
pen.speed(0)

# --- HELPER FUNCTIONS ---
def draw_rect(x, y, width, height, color):
    """Draws a filled rectangle from the top-left corner."""
    pen.penup()
    pen.goto(x, y)
    pen.pendown()
    pen.fillcolor(color)
    pen.pencolor(color)
    pen.begin_fill()
    for _ in range(2):
        pen.forward(width)
        pen.right(90)
        pen.forward(height)
        pen.right(90)
    pen.end_fill()

def draw_mountain(x, y, base, height, color):
    """Draws a triangle to represent a mountain."""
    pen.penup()
    pen.goto(x, y)
    pen.pendown()
    pen.fillcolor(color)
    pen.pencolor(color)
    pen.begin_fill()
    pen.goto(x + base/2, y + height) # Go to the peak
    pen.goto(x + base, y)            # Go to bottom right
    pen.goto(x, y)                   # Back to start
    pen.end_fill()

# --- DRAWING THE WORLD ---

# 2. THE SUN
pen.penup()
pen.goto(80, 100)
pen.pendown()
pen.fillcolor("yellow")
pen.pencolor("yellow")
pen.begin_fill()
pen.circle(30)
pen.end_fill()

# 3. BACKGROUND MOUNTAINS
# Mountain 1 (Taller, in the back)
draw_mountain(-200, -50, 200, 150, "slategray")
# Mountain 2 (Shorter, slightly overlapping)
draw_mountain(-50, -50, 250, 120, "lightslategray")

# 4. THE GRASS (Top layer of the ground)
# We draw this starting slightly higher than the dirt
draw_rect(-200, -30, 400, 20, "#228B22") # Forest Green hex code

# 5. THE DIRT (Underground layer)
draw_rect(-200, -50, 400, 150, "#8B4513") # Saddle Brown hex code

# Render everything to the screen
screen.update()
